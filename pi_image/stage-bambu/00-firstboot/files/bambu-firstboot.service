[Unit]
Description=Bambu Pi Controller Ersteinrichtung (einmalig)
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/var/lib/bambu-firstboot.done

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/bambu-pi-controller/pi_image/stage-bambu/00-firstboot/files/bambu-firstboot.sh
ExecStartPost=/bin/touch /var/lib/bambu-firstboot.done
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
