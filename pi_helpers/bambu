#!/bin/bash
# bambu — Helfer für den Bambu Pi Controller (wird vom Installer nach /usr/local/bin kopiert)
#   sudo bambu status | iphone | logs | update | reconfigure | restart
INSTALL_DIR="/opt/bambu-pi-controller"
SERVICE_USER="bambu"

cmd="${1:-help}"
case "$cmd" in
  status)
    echo "— Version —"
    git -C "$INSTALL_DIR" log -1 --oneline 2>/dev/null || echo "unbekannt"
    echo ""
    echo "— Container —"
    sudo -u "$SERVICE_USER" docker compose -f "$INSTALL_DIR/docker-compose.yml" ps
    echo ""
    echo "— Gesundheit —"
    curl -s http://localhost:8000/health || echo "Server antwortet nicht"
    echo ""
    echo "— Adressen —"
    echo "LAN:       http://$(hostname -I | awk '{print $1}'):8000"
    echo ""
    echo "— Fernzugriff (Cloudflare Quick Tunnel) —"
    TOKEN=$(grep "^API_TOKEN=" "$INSTALL_DIR/pi_backend/.env" 2>/dev/null | cut -d= -f2)
    if [[ -n "$TOKEN" ]]; then
      curl -s -H "Authorization: Bearer $TOKEN" \
        http://localhost:8000/api/v1/system/remote-access || echo "Server antwortet nicht"
    else
      echo "Nicht konfiguriert — erst install.sh laufen lassen."
    fi
    ;;
  iphone)
    cat "$INSTALL_DIR/IPHONE_SETUP.txt" 2>/dev/null || echo "Noch nicht installiert. Erst install.sh laufen lassen."
    ;;
  logs)
    sudo -u "$SERVICE_USER" docker compose -f "$INSTALL_DIR/docker-compose.yml" logs -f bambu-controller
    ;;
  restart)
    sudo -u "$SERVICE_USER" docker compose -f "$INSTALL_DIR/docker-compose.yml" restart
    echo "Neu gestartet."
    ;;
  update)
    # Zentrale Update-Logik in install.sh (robuster Git-Pull als Dienst-User,
    # Helfer + mDNS nachrüsten, Rechte, Neubau inkl. Slicer).
    exec bash "$INSTALL_DIR/install.sh" --update
    ;;
  reconfigure)
    exec bash "$INSTALL_DIR/install.sh" --configure
    ;;
  repair)
    echo "Gebe Pi für ein neues Handy frei (Druckerdaten bleiben)…"
    TOKEN=$(grep "^API_TOKEN=" "$INSTALL_DIR/pi_backend/.env" 2>/dev/null | cut -d= -f2)
    if [[ -z "$TOKEN" ]]; then echo "Kein Token gefunden — erst install.sh laufen lassen."; exit 1; fi
    curl -sf -X POST -H "Authorization: Bearer $TOKEN" http://localhost:8000/api/v1/pairing/reset && echo "Bereit — in der App erneut verbinden."
    ;;
  tunnel)
    # Fernzugriff per Cloudflare Quick Tunnel (kein Konto, kein Login).
    TOKEN=$(grep "^API_TOKEN=" "$INSTALL_DIR/pi_backend/.env" 2>/dev/null | cut -d= -f2)
    if [[ -z "$TOKEN" ]]; then echo "Kein Token gefunden — erst install.sh laufen lassen."; exit 1; fi
    ACTION="${2:-start}"
    URL="http://localhost:8000/api/v1/system/remote-access"
    case "$ACTION" in
      stop)
        curl -sf -X DELETE -H "Authorization: Bearer $TOKEN" "$URL" ;;
      status)
        curl -sf -H "Authorization: Bearer $TOKEN" "$URL" ;;
      *)
        curl -sf -X POST -H "Authorization: Bearer $TOKEN" "$URL" ;;
    esac
    echo ""
    ;;
  *)
    echo "Benutzung: sudo bambu {status|iphone|logs|restart|update|reconfigure|repair|tunnel}"
    echo "  status      Zeigt Container, Gesundheit und Adressen"
    echo "  iphone      Zeigt Server-URL + Token für die iPhone-App"
    echo "  logs        Live-Protokoll des Servers"
    echo "  restart     Server neu starten"
    echo "  update      Neueste Version holen + neu starten"
    echo "  reconfigure Zugangs-Token neu erzeugen"
    echo "  repair      Pi für ein neues Handy freigeben"
    echo "  tunnel      Fernzugriff starten (tunnel {start|status|stop})"
    ;;
esac
