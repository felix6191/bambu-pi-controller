# Bambu Lab Printer Settings
PRINTER_HOST=192.168.1.100
PRINTER_SERIAL=01S00A123456789
PRINTER_ACCESS_CODE=12345678
PRINTER_PORT=8883
PRINTER_USE_TLS=true

# Server Settings
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# API Security (generate: openssl rand -hex 32)
API_TOKEN=your-secure-api-token-here

# Tailscale (for remote access via install.sh / docker-compose)
TAILSCALE_AUTHKEY=

# Camera (optional)
# CAMERA_URL=http://192.168.1.100:8080/stream
# CAMERA_USERNAME=
# CAMERA_PASSWORD=