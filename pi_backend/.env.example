# Bambu Lab Printer Settings
PRINTER_HOST=192.168.1.100
PRINTER_SERIAL=01S00A123456789
PRINTER_ACCESS_CODE=12345678
PRINTER_PORT=8883
PRINTER_USE_TLS=true

# Server Settings
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# API Security (generate: openssl rand -hex 32)
API_TOKEN=your-secure-api-token-here

# Slicer (im Docker-Image integriert; Standard: OrcaSlicer)
# SLICER_MODE=orca
# ORCA_PROFILES=/opt/orcaslicer/resources/profiles/BBL
# SLICER_CMD=orcaslicer
# Für den alten PrusaSlicer-Pfad:
# SLICER_MODE=prusa
# SLICER_CMD=prusa-slicer
# SLICER_TEMPLATE={cmd} --export-gcode --output {out} --load {machine} --load {filament} --load {process} {input}

# Camera: nichts nötig — das Bild kommt automatisch vom Drucker (Port 6000).
# Nur als Override (z. B. USB-Kamera am Pi):
# CAMERA_URL=http://192.168.1.100:8080/stream
# CAMERA_USERNAME=
# CAMERA_PASSWORD=